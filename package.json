{
  "name": "dsh-research-companion",
  "description": "macOS research assistant bridge for a local DeepSeek Harness Desktop.",
  "version": "0.2.6",
  "type": "module",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "web-ui",
    "dsh-mac-pet",
    "dsh-pet",
    "status",
    "desktop"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown && node scripts/build-client.mjs",
    "test:protocol": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch",
    "build:local": "node scripts/build-local.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.2 || ^0.2.0-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.1",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2",
    "esbuild": "0.25.12"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "config"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.2.3-0",
    "node": ">=24.15.0"
  },
  "private": true
}
